{
  "description": "Linting, formatting, safety guardrails, and desktop notifications for Claude Code sessions.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/lint-python.sh"
          },
          {
            "type": "command",
            "command": "./scripts/format-js.sh"
          },
          {
            "type": "command",
            "command": "./scripts/format-go.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/guard-destructive.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/notify.sh \"Claude Code\" \"Claude finished responding\" \"Glass\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/notify.sh \"Claude Code\" \"Subagent finished\" \"Tink\""
          }
        ]
      }
    ]
  }
}
