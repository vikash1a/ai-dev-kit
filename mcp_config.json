{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "notion-mcp-server"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "atlassian": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ]
    },
    "google-sheets": {
      "command": "npx",
      "args": [
        "-y",
        "google-sheets-mcp"
      ],
      "env": {
        "GOOGLE_ACCESS_TOKEN": "3a281dd126b9ccf10d89385aa0c543270820f461"
      }
    },
    "custom-starter": {
      "command": "node",
      "args": [
        "./starter-mcp.js"
      ],
      "disabled": true
    }
  }
}
